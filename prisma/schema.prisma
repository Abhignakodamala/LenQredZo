generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id           Int      @id @default(autoincrement())
  name         String
  logo         String?
  primaryColor String?  @default("#1e40af")
  subdomain    String?  @unique
  plan         String   @default("starter")
  whatsappToken          String?
  whatsappPhoneNumberId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  users        User[]
  customers    Customer[]
  loans        Loan[]
  branches     Branch[]
  whatsAppSettings WhatsAppSettings?
}

model Branch {
  id        Int      @id @default(autoincrement())
  name      String
  address   String?
  phone     String?
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  customers Customer[]
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String
  phone     String?  // ← add this line
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])
  branchId  Int?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  passkeys  Passkey[]
}

model Passkey {
  id           String   @id @default(cuid())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    String
  counter      BigInt   @default(0)
  deviceType   String?
  backedUp     Boolean  @default(false)
  transports   String?
  nickname     String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?
}

model Customer {
  id        Int      @id @default(autoincrement())

  // ── Core (existing) ──────────────────────────────────────────────
  name      String                         // kept for backward compat (full name fallback)
  email     String?
  phone     String
  address   String?                        // kept for backward compat
  aadhar    String?                        // AES-256 encrypted
  pan       String?                        // AES-256 encrypted
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])
  branchId  Int?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  loans     Loan[]
  whatsAppMessages WhatsAppMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Section 1: Personal Information ──────────────────────────────
  firstName       String?
  middleName      String?
  lastName        String?
  dateOfBirth     DateTime?
  gender          String?    // Male | Female | Other
  maritalStatus   String?    // Single | Married | Divorced | Widowed
  nationality     String?    @default("Indian")

  // ── Section 2: Identity & Regulatory ─────────────────────────────
  // pan + aadhar already above (encrypted)
  altIdType       String?    // Passport | Driver's License | Voter ID
  altIdNumber     String?    // encrypted at application layer

  // ── Section 3: Contact & Residential ─────────────────────────────
  alternateMobile String?
  street          String?
  city            String?
  state           String?
  pinCode         String?
  residenceType   String?    // Self-Owned | Rented | Parental/Family | Company Provided
  permanentAddress String?   // null means same as current

  // ── Section 4: Employment & Financial ────────────────────────────
  employmentType  String?    // Salaried | Self-Employed Professional | Business Owner | Unemployed
  employerName    String?
  designation     String?
  workEmail       String?
  monthlyIncome   Float?
  bankName        String?
  bankAccountNumber String?  // store encrypted at application layer

  // ── Section 5: Declarations ───────────────────────────────────────
  isPEP                Boolean  @default(false)   // Politically Exposed Person
  isForeignTaxResident Boolean  @default(false)
  nomineeName          String?
  nomineeRelation      String?

  // ── Section 6: Legal Consent ──────────────────────────────────────
  consentGiven    Boolean   @default(false)
  consentDate     DateTime?
  consentPlace    String?
}

model Loan {
  id           Int      @id @default(autoincrement())
  customerId   Int
  customer     Customer @relation(fields: [customerId], references: [id])
  companyId    Int?
  company      Company? @relation(fields: [companyId], references: [id])
  type         String
  amount       Float
  interestRate Float
  interestType String   @default("percentage")
  frequency    String   @default("monthly")
  tenure          Int
  disbursedAmount Float?
  deductUpfront      Boolean  @default(false)
  processingFee      Float    @default(0)
  processingFeeType  String   @default("percentage")
  penaltyType        String   @default("none")
  penaltyValue       Float    @default(0)
  status             String   @default("pending")
  disbursedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  emis         EMI[]
  payments     Payment[]
  guarantors   Guarantor[]
  roundEmi          Boolean   @default(false)
}

model EMI {
  id        Int      @id @default(autoincrement())
  loanId    Int
  loan      Loan     @relation(fields: [loanId], references: [id])
  amount    Float
  dueDate   DateTime
  status      String   @default("pending")
  penalty     Float    @default(0)
  penaltyPaid Boolean  @default(false)
  createdAt   DateTime @default(now())
  paidAmount Int @default(0)
}

model Payment {
  id        Int      @id @default(autoincrement())
  loanId    Int
  loan      Loan     @relation(fields: [loanId], references: [id])
  amount    Float
  method    String
  status    String   @default("pending")
  paidAt    DateTime?
  createdAt DateTime @default(now())
  reference String?
  verified  Boolean @default(false)
}



model AuditLog {
  id         Int      @id @default(autoincrement())
  companyId  Int
  userId     Int?
  userName   String?
  action     String   // e.g. "MARK_EMI_PAID", "CREATE_CUSTOMER", "UPDATE_CUSTOMER"
  entityType String   // e.g. "EMI", "Customer", "Loan", "Payment"
  entityId   Int?
  details    String?  // human-readable summary — never raw Aadhaar/PAN
  photoData  String?  @db.Text
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
}
model OTP {
  id        Int      @id @default(autoincrement())
  email     String?
  phone     String?
  code      String
  type      String   // email_verify | login_otp | forgot_password
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, type])
  @@index([phone, type])
}

model Guarantor {
  id                Int      @id @default(autoincrement())
  loanId            Int
  loan              Loan     @relation(fields: [loanId], references: [id])

  // A. Personal & Identity
  name              String
  relationship      String?  // Parent | Spouse | Sibling | Business Partner | Other
  dateOfBirth       DateTime?
  aadhar            String?  // AES-256 encrypted
  pan               String?  // AES-256 encrypted

  // B. Contact & Residential
  phone             String
  email             String?
  address           String?
  city              String?
  pinCode           String?

  // C. Employment & Financial
  employmentType    String?  // Salaried | Self-Employed Professional | Business Owner
  employerName      String?
  grossAnnualIncome Float?
  bankName          String?
  bankAccountNumber String?  // AES-256 encrypted

  // Legal Consent
  consentGiven      Boolean  @default(false)
  consentDate       DateTime?

  type              String   @default("guarantor")
  details           String?
  createdAt         DateTime @default(now())
}

model WhatsAppSettings {
  id            Int      @id @default(autoincrement())
  companyId     Int      @unique
  company       Company  @relation(fields: [companyId], references: [id])
  accessToken   String
  phoneNumberId String
  businessName  String
  isEnabled     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WhatsAppMessage {
  id          Int      @id @default(autoincrement())
  companyId   Int
  customerId  Int
  customer    Customer @relation(fields: [customerId], references: [id])
  direction   String   // sent | received
  message     String
  messageType String   @default("text")
  status      String   @default("sent") // sent | delivered | read | failed
  sentAt      DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([companyId, customerId])
}